generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Policy {
  id                 String       @id @default(uuid())
  fileName           String
  filePath           String
  status             String       @default("UPLOADED") // UPLOADING, UPLOADED, PARSING, EXTRACTING, VALIDATING, READY, FAILED
  insurerName        String?
  policyName         String?
  rawMarkdown        String?      @db.Text
  parsedDocumentJson Json?
  extractionVersion  String?      @default("1.0.0")
  errorMessage       String?      @db.Text
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  rules              PolicyRule[]
  citations          Citation[]
  calculations       Calculation[]

  @@map("policies")
}

model PolicyRule {
  id              String     @id @default(uuid())
  policyId        String
  ruleType        String     // SUM_INSURED, ROOM_RENT_CAP, COPAY, PROCEDURE_SUBLIMIT, DEDUCTIBLE, EXCLUSION, WAITING_PERIOD, OTHER
  ruleName        String
  value           Float?
  unit            String?    // INR, %, DAYS, MONTHS
  description     String?    @db.Text
  sourcePage      Int?
  sourceText      String?    @db.Text
  boundingBox     Json?
  confidenceLevel String?    @default("HIGH") // HIGH, MEDIUM, LOW
  createdAt       DateTime   @default(now())

  policy          Policy     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  citations       Citation[]

  @@index([policyId])
  @@map("policy_rules")
}

model Procedure {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  category      String
  description   String?        @db.Text
  createdAt     DateTime       @default(now())

  hospitalCosts HospitalCost[]
  calculations  Calculation[]

  @@map("procedures")
}

model HospitalCost {
  id                    String    @id @default(uuid())
  procedureId           String
  city                  String    @default("National Average")
  roomCategory          String    // GENERAL, TWIN_SHARING, SINGLE_PRIVATE, DELUXE
  roomRate              Float
  stayDays              Int       @default(1)
  proportionateCosts    Float
  nonProportionateCosts Float
  otherCosts            Float     @default(0)
  totalBill             Float
  currency              String    @default("INR")
  source                String?   @default("Reference Benchmark Hospital Schedule of Charges")
  createdAt             DateTime  @default(now())

  procedure             Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([procedureId, roomCategory])
  @@map("hospital_costs")
}

model Calculation {
  id                   String     @id @default(uuid())
  policyId             String
  procedureId          String
  scenarioJson         Json
  inputJson            Json
  resultJson           Json
  calculationTraceJson Json
  engineVersion        String     @default("1.0.0")
  createdAt            DateTime   @default(now())

  policy               Policy     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  procedure            Procedure  @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([procedureId])
  @@map("calculations")
}

model Citation {
  id           String      @id @default(uuid())
  policyId     String
  policyRuleId String?
  pageNumber   Int
  sourceText   String      @db.Text
  boundingBox  Json?
  createdAt    DateTime    @default(now())

  policy       Policy      @relation(fields: [policyId], references: [id], onDelete: Cascade)
  policyRule   PolicyRule? @relation(fields: [policyRuleId], references: [id], onDelete: SetNull)

  @@index([policyId])
  @@map("citations")
}
